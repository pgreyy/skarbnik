# (with the byte sweep), and the rule checker for bugs judged by a public rule module. Rebuild any of them with
# scripts/check_image_id.sh.
CHECKERS = {'crash': 'dd6c5f42c117ce3a842dbde60cd3fd9f255c85e322317e6bff2357b20533a2fc',
            'output': '005d8dc7e6fa2b936d960f6c81af51b5cb3699d319b5d4b71403dd64b051c089',
            'rule': '2c7b601aeae96b0df295d2f7f7be842792637883148ec2cd26226b6018bfe6aa'}
RULE_CORPUS_DOMAIN = b'skarbnik-rule-corpus-v1'  # harness/checker-rule/src/lib.rs, CORPUS_DOMAIN
