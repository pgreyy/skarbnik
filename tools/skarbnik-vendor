    ('secrets', 'secret', 'path of the secret file, outside the repository: crash mode, the crashing input as hex; output mode, one line <input as hex> <expected value> [sweep=<p>,<p>]; rule mode, one line <call sequence as hex> [sweep=<p>,<p>]', '~/.skarbnik-vendor/mybounty/exploit.hex'),
    ('secrets', 'reference_fix', 'path of your reference fix (.wasm), outside the repository', '~/.skarbnik-vendor/mybounty/fixed.wasm'),
    ('prover', 'mode', 'where proving runs: gpu (a rented GPU pod per proof) or cpu (this machine)', 'gpu'),
    ('prover', 'workdir', 'folder for receipts and logs, outside the repository', '~/skarbnik-vendor/mybounty'),
    ('chain', 'vendor_account', 'your vendor account (signs create and open)', 'you.testnet'),
]

def cmd_init(a):
    base = load(a.from_) if a.from_ else tomllib.load(open(f'{ROOT}/tools/vendor.example.toml', 'rb'))
    out = os.path.abspath(os.path.expanduser(a.out))
    if inside_repo(out): fail('write the config outside the repository; it names your secret files')
    for sec, key, q, default in QUESTIONS:
        cur = str(base.get(sec, {}).get(key, default))
        if a.yes: continue
        ans = input(f'{q} [{cur}]: ').strip()
        if ans: base.setdefault(sec, {})[key] = ans
    for sec, key in (('secrets', 'secret'), ('secrets', 'reference_fix'), ('prover', 'workdir')):
        if inside_repo(os.path.expanduser(str(base[sec][key]))): fail(f'{sec}.{key} must point outside the repository')
    mode = mode_of(base['bounty']); base['bounty']['mode'] = mode
    if mode == 'crash': base['bounty'].pop('sweep', None)
    if mode == 'rule':
        module = base['bounty'].get('module', 'data/demo')
        if not base['bounty'].get('rule'): base['bounty']['rule'] = os.path.join(module, 'rule.wasm')
        if not os.path.isfile(rule_of(base['bounty'], module)): say(f'note: no rule module at {base["bounty"]["rule"]} yet; check refuses until it is there')
    else: base['bounty'].pop('rule', None)
    if len(config_sweep(base['bounty'])) > 4: fail('at most 4 sweep positions')
    if base.get('chain', {}).get('image_id') in CHECKERS.values() or not base.get('chain', {}).get('image_id'):
        base.setdefault('chain', {})['image_id'] = CHECKERS[mode]
    lines = []
    for sec, vals in base.items():
        if sec.startswith('_') or not isinstance(vals, dict): continue
        lines.append(f'[{sec}]')
        for k, v in vals.items():
            num = isinstance(v, (int, float)) or (isinstance(v, str) and re.fullmatch(r'\d+', v) and k in ('k', 'max_commits_per_account', 'level', 'reveal_gap_s', 'reveal_window_s', 'verdict_window_h', 'expiry_h', 'po2', 'max_patch_bytes', 'fuzz_count', 'variants'))
            lines.append(f'{k} = {json.dumps(v) if not num else int(v) if isinstance(v, str) else v}')
        lines.append('')
    os.makedirs(os.path.dirname(out), exist_ok=True)
    open(out, 'w').write('# skarbnik-vendor bounty config (tools/vendor.example.toml). Keep it outside the repository.\n' + '\n'.join(lines))
    os.chmod(out, 0o600)
    say(f'wrote {out}. Next: tools/skarbnik-vendor check --config {out}')

# ---------------------------------------------------------------- check and preview
def preview(cfg, est):
    b = cfg['bounty']; k = int(b['k']); fee = yocto(b['attempt_fee_near']); step = yocto(b['fee_step_near'])
    say('\nPreview')
    say(f'  reward: {b["reward_near"]} NEAR, locked in the contract when the bounty is created')
    lv = level_of(cfg)
    say(f'  level {lv}: {LEVELS[lv][0]}')
    for n in (2, 1, 0):
        say(f'    {"->" if n == lv else "  "} level {n} costs: {LEVELS[n][1]}')
    cap = int(b.get('max_commits_per_account', 0) or 0)
    if cap: say(f'  per account: at most {cap} of the {k} attempt slots at a time')
    say(f'  attempts: up to {k}; fees, taken from each researcher\'s credit: ' + ', '.join(f'#{i + 1} {near_amount(fee + i * step)}' for i in range(k)))
    say(f'  windows: reveal {span(b["reveal_gap_s"])} to {span(b["reveal_window_s"])} after a commit; your proof within {b["verdict_window_h"]} h of each reveal; the bounty expires after {b["expiry_h"]} h')
    say('  on timeout: if you do not prove a revealed attempt within its verdict window, anyone can call claim_timeout and the')
    say('    reward is split equally among the revealed attempts still waiting. The contract does not look at the fix: it pays')
    say('    whatever was revealed. That protects researchers from a silent vendor; it is not a verdict.')
    if est:
        mode = cfg['prover']['mode']
        key = f'{mode}@{cfg["prover"].get("machine", "this machine")}:{os.path.basename(cfg["bounty"]["module"].rstrip("/"))}'
        src = 'tools/proof_times.json' if key in json.load(open(f'{ROOT}/tools/proof_times.json'))['per_attempt_seconds'] else "this bounty's own Proof 0"
        say(f'  proving one attempt ({mode}): about {hm(est)} (measured, {src}); cost: {"electricity and machine time" if mode == "cpu" else "GPU rental time"}')
        say(f'  time to open: Proof 0 (about {hm(est)}) plus two transactions')

def checker_call(cfg, module):
    """The native checker of this bounty's mode and its arguments that name the bounty's files (never their contents)."""
    b, s = cfg['bounty'], cfg['secrets']; mode = mode_of(b)
    common = ['--original', f'{module}/original.wasm', '--tests', f'{module}/public_tests.txt']
    if mode == 'rule': return binpath(cfg, 'check_rule'), common + ['--rule', rule_of(b, module), '--secret', s['secret'], '--reference-fix', s['reference_fix']]
    if mode == 'output': return binpath(cfg, 'check_output'), common + ['--secret', s['secret'], '--reference-fix', s['reference_fix']]
    return binpath(cfg, 'check'), common + ['--exploit', s['secret']]

def check_candidate(cfg, module, cand, seed=None, explain=False):
    """check --candidate: the native checker on one file, with the bounty's settings; no chain, no proof. Prints the verdict
    (and with --explain the step that decided, which can name a sweep position: for the vendor's eyes only)."""
    b = cfg['bounty']; mode = mode_of(b); chk, common = checker_call(cfg, module)
    if not os.path.isfile(cand): fail(f'candidate not found: {cand}')
    seed = seed or os.urandom(32).hex()
    r = subprocess.run([chk, 'check', '--candidate', cand, *common, '--seed', seed, '--fuzz-count', str(int(b.get('fuzz_count', 16))),
                        '--variants', str(int(b.get('variants', 32))), *(['--explain'] if explain else [])], capture_output=True, text=True)
    lines = r.stdout.splitlines()
    verdict = lines[0].strip() if lines and lines[0].strip() in ('PASS', 'FAIL') else None
    if verdict is None: fail(f'the {mode} checker gave no verdict: {(r.stderr.strip().splitlines() or ["no output"])[-1][:200]}')
    say(f'{mode} checker on {cand}: {verdict} (seed {seed[:16]}..., fuzz {b.get("fuzz_count", 16)}, variants {b.get("variants", 32)})')
    if explain: [say(f'  {l}') for l in lines[1:] if l.startswith('reason (internal)')]
    if mode == 'rule': say(f'corpus hash (rule checker): {rule_corpus_hash(rule_of(b, module), f"{module}/public_tests.txt")}')
    sys.exit(0 if verdict == 'PASS' else 1)

def cmd_check(a):
    cfg = load(a.config); b, s, pr = cfg['bounty'], cfg['secrets'], cfg['prover']
    problems = []; ok = lambda m: say(f'  ok   {m}')
    module = os.path.join(ROOT, b['module']) if not os.path.isabs(b['module']) else b['module']
    if a.candidate: return check_candidate(cfg, module, os.path.abspath(os.path.expanduser(a.candidate)), a.seed, a.explain)
    say(f'Preflight for {b["name"]} ({cfg["_path"]})')
    mode = mode_of(b)
    for f in ('original.wasm', 'public_tests.txt'):
        if not os.path.isfile(f'{module}/{f}'): problems.append(f'{b["module"]}/{f} is missing')
    if mode == 'rule':
        rule = rule_of(b, module)
        if not os.path.isfile(rule): problems.append(f'the rule module {b.get("rule") or b["module"] + "/rule.wasm"} is missing')
        elif os.path.getsize(rule) > MAX_RULE_BYTES: problems.append(f'the rule module is {os.path.getsize(rule)} bytes; the rule checker takes at most {MAX_RULE_BYTES:,}')
    # A split setup: the secret and the reference fix stay on the proving machine, which made Proof 0 and ran these
    # checks there; this computer only publishes. Then the Proof 0 files must be here and match this module.
    w = os.path.expanduser(pr.get('workdir', ''))
    split = not any(os.path.exists(s[k]) for k in ('secret', 'reference_fix')) and os.path.isfile(f'{w}/verify_p0.txt')
    if not split:
        for key in ('secret', 'reference_fix'):
            p = s[key]
            if inside_repo(p): problems.append(f'{key} is inside the repository; keep it outside')
            elif not os.path.isfile(p): problems.append(f'{key} file not found: {p}')
            elif oct(os.stat(p).st_mode)[-3:] != '600': problems.append(f'{key} is readable by others (mode {oct(os.stat(p).st_mode)[-3:]}); make it 600')
    if problems: fail('; '.join(problems))
    cap = int(b.get('max_commits_per_account', 0) or 0)
    if cap and not 1 <= cap <= int(b['k']): problems.append(f'max_commits_per_account is {cap}; it must be 1 to K ({b["k"]}), or 0 for no cap')
    size = os.path.getsize(f'{module}/original.wasm'); tests = sum(1 for l in open(f'{module}/public_tests.txt') if l.strip() and not l.startswith('#'))
    if size > 2048: problems.append(f'the module is {size} bytes; the checker takes at most 2,048')
    else: ok(f'module {b["module"]}/original.wasm, {size} bytes; {tests} public tests')
    if not split:
        fixsize = os.path.getsize(s['reference_fix'])
        if fixsize > int(b.get('max_patch_bytes', 1024)): problems.append(f'the reference fix is {fixsize} bytes, above max_patch_bytes')
    if cfg['chain'].get('image_id') != CHECKERS[mode]:
        problems.append(f'chain.image_id is not the {mode} checker ({CHECKERS[mode][:16]}...); set it, or set bounty.mode')
    chk, common = checker_call(cfg, module)
    if mode == 'rule':
        try: ok(f'rule module {os.path.getsize(rule_of(b, module))} bytes; corpus hash (rule, public tests) {rule_corpus_hash(rule_of(b, module), f"{module}/public_tests.txt")[:16]}...')
        except (OSError, ValueError) as e: problems.append(f'the corpus hash could not be computed: {e}')
    if split:
        v0 = open(f'{w}/verify_p0.txt').read()
        if journal(v0, 'original_hash') != sha_file(f'{module}/original.wasm') or journal(v0, 'verdict') != 'PASS':
            problems.append('the Proof 0 files here are not a PASS for this module')
        else: ok('the secret and the reference fix stay on the proving machine; the Proof 0 made there is here: PASS for this module')
    elif mode in ('output', 'rule'):
        # Nothing from the secret file is shown: only which step decided, never a value.
        try:
            sw, want = secret_sweep(s['secret'], mode), config_sweep(b)
            if sw != want: problems.append('the sweep positions on the secret line and bounty.sweep differ; write the same list in both')
            elif sw: ok(f'{len(sw)} private sweep position(s), the same on the secret line and in the config')
            else: say('  note no sweep positions: a partial fix that is right on the secret but wrong on nearby lengths may pass')
        except (OSError, ValueError, IndexError):
            problems.append('the secret file is not one line ' + ('<call sequence as hex> [sweep=<p>,<p>]' if mode == 'rule' else '<input as hex> <expected value> [sweep=<p>,<p>]'))
        orig = subprocess.run([chk, 'check', '--candidate', f'{module}/original.wasm', *common, '--seed', '00' * 32, '--fuzz-count', '1', '--variants', '1', '--explain'], capture_output=True, text=True)
        if mode == 'rule':
            if 'reason (internal): 2 secret: the rule says violation' not in orig.stdout:
                problems.append('the rule does not say violation for the original on the secret call sequence (or it traps there, or a file is not readable)')
            else: ok('the original runs the secret call sequence without a trap, and the rule says violation')
        elif 'reason (internal): 2 secret' not in orig.stdout: problems.append('the original does not give a wrong answer on the secret input (or the secret file is not readable)')
        else: ok('the original gives another answer than the expected one on the secret input')
    else:
        crash = subprocess.run([chk, 'check', '--candidate', f'{module}/original.wasm', *common, '--seed', '00' * 32, '--fuzz-count', '16', '--variants', '32', '--explain'], capture_output=True, text=True)
        if not re.search(r'exploit: (trapped|out of fuel)', crash.stdout): problems.append('the original does not crash on the secret input')
        else: ok('the original crashes on the secret input')
    if not split:
        passes = 0
        for i in range(4):
            seed = hashlib.sha256(f'{b["name"]}:{i}:{time.time()}'.encode()).hexdigest()
            fixarg = ['--reference-fix', s['reference_fix']] if mode == 'crash' else []
            r = subprocess.run([chk, 'proof0', *common, *fixarg, '--seed', seed, '--fuzz-count', '64', '--variants', '64'], capture_output=True, text=True)
            passes += r.returncode == 0 and 'proof0: PASS' in r.stdout
        if passes != 4: problems.append(f'Proof 0 (the original is wrong on the secret, the reference fix passes the full check) passed on {passes} of 4 seeds')
        else: ok('Proof 0 passes on 4 random seeds: the reference fix passes the full check')
    po2 = int(b.get('po2', 18)); avail, swap = mem_mib(); lv = level_of(cfg)
    if lv not in LEVELS: problems.append(f'bounty.level {lv} is not 0, 1 or 2')
    need = max(PROVE_NEED_MIB.get(po2, 5000), GROTH16_NEED_MIB) if lv == 2 else PROVE_NEED_MIB.get(po2, 5000)
    what = 'the Groth16 wrap' if lv == 2 else 'proving (no Groth16 step at this level)'
    if avail + min(swap, 2048) < need: problems.append(f'not enough memory here for {pr["mode"]} proving: {avail} MiB available + {swap} MiB swap, needs about {need} MiB ({what})')
    else: ok(f'memory: {avail} MiB available, {swap} MiB swap; proving needs about {PROVE_NEED_MIB.get(po2)} MiB at --po2 {po2}' + (f', the Groth16 wrap about {GROTH16_NEED_MIB} MiB' if lv == 2 else ''))
    if lv == 1:
        try:
            ol = view(cfg, 'get_outlayer')
            if ol: ok(f'Level 1: OutLayer is set ({ol["account_id"]}, program sha256 {ol["wasm_sha256"][:16]}..., min_deposit {near_amount(ol["min_deposit"])})')
            else: problems.append('Level 1: the contract has no OutLayer settings yet (the owner sets them)')
        except Exception as e: problems.append(f'could not read the OutLayer settings: {e}')  # noqa: BLE001
    if lv == 0:
        try: ok(f'Level 0: {len(view(cfg, "get_verifiers"))} registered verifiers (run by the project); they must attest Proof 0 before the bounty opens')
        except Exception as e: problems.append(f'could not read the verifiers: {e}')  # noqa: BLE001
    if pr['mode'] not in ('cpu', 'gpu'): problems.append(f'prover mode {pr["mode"]} is not known; use gpu or cpu')
    try:
        allowed = view(cfg, 'get_allowed_image_ids')
        if cfg['chain']['image_id'] in allowed: ok(f'checker image id {cfg["chain"]["image_id"][:16]}... is on the contract\'s allowlist')
        else: problems.append('the checker image id is not on the contract\'s allowlist')
    except Exception as e: problems.append(f'could not read the allowlist: {e}')  # noqa: BLE001
    bal = balance(cfg, cfg['chain']['vendor_account']); need_near = yocto(b['reward_near']) + yocto('0.2')
    if bal is None: problems.append(f'vendor account {cfg["chain"]["vendor_account"]} not found')
    elif bal < need_near: problems.append(f'vendor balance {near_amount(bal)} is below the reward plus 0.2 NEAR for gas and storage')
    else: ok(f'vendor balance {near_amount(bal)}')
    est, _ = proof_time(pr['mode'], b['module'], pr.get('workdir'), pr.get('machine', 'this machine'))
    why = window_rule(cfg, est)
    if est is None: say(f'  note {why}; publish refuses until it is measured')
    elif why: problems.append(why)
    else: ok(f'verdict window {b["verdict_window_h"]} h covers K x proof time x {MARGIN} = {hm(int(b["k"]) * est * MARGIN)}')
    preview(cfg, est)
    if problems: say(''); fail('\n  - ' + '\n  - '.join(problems))
    say('\nPreflight passed.')

# ---------------------------------------------------------------- prove0 and publish
def cmd_prove0(a):
    cfg = load(a.config); b, s = cfg['bounty'], cfg['secrets']; w = os.path.expanduser(cfg['prover']['workdir']); os.makedirs(w, mode=0o700, exist_ok=True)
    seedf = f'{w}/proof0_seed.txt'
    if not os.path.exists(seedf):
        fd = os.open(seedf, os.O_WRONLY | os.O_CREAT, 0o600); os.write(fd, os.urandom(32).hex().encode()); os.close(fd)
    seed = open(seedf).read().strip()
    module = os.path.join(ROOT, b['module']) if not os.path.isabs(b['module']) else b['module']
    if cfg['prover']['mode'] == 'gpu':
        # Proof 0 on a rented GPU pod (the secret and the salt in the pod's RAM only, wiped; the pod always terminated),
        # then the Groth16 wrap here, as watch does for attempts.
        say(f'{now()} Proof 0 of {b["name"]} on a GPU pod: prove and shrink there{", Groth16 here" if level_of(cfg) == 2 else ""} (logs in {w})')
        job = {'bounty_id': b['name'], 'index': 'p0', 'name': b['name'], 'module': module, 'patch': s['reference_fix'], 'secret': s['secret'],
               'salt': os.path.expanduser(f'~/.kintsugi-salts/{b["name"]}.salt'), 'seed': seed, 'sid': None, 'proof0': True,
               'fuzz': int(b.get('fuzz_count', 16)), 'variants': int(b.get('variants', 32)), 'image_id': cfg['chain']['image_id'], 'workdir': w}
        if mode_of(b) in ('output', 'rule'): job['reference_fix'] = s['reference_fix']  # the checker compares with it; RAM only on the pod
        if mode_of(b) == 'rule': job['rule'] = rule_of(b, module)  # the public rule module, next to the module on the pod
        if not os.path.exists(job['salt']): fail(f'no salt for bounty {b["name"]} in ~/.kintsugi-salts/ (skarbnik-host makes it on first use)')
        with ProverLock():
            try: _, t = gpu.prove_on_gpu(cfg, job, lambda m: say(f'{now()} {m}'))
            except gpu.GpuError as e: fail(f'Proof 0 on a GPU did not finish: {e}; nothing was sent; run prove0 again later')
            os.replace(f'{w}/u_succinct.bin', f'{w}/p0_succinct.bin')
            if level_of(cfg) == 2: v, t['groth16'] = wrap(cfg, w, 'p0', mode_of(b))
            else: v = verify_succinct(cfg, w, 'p0', mode_of(b))
    else:
        say(f'{now()} Proof 0 of {b["name"]}: prove, succinct{", Groth16" if level_of(cfg) == 2 else ""}, one step at a time (logs in {w})')
        v, t = prove_chain(cfg, w, b['name'], s['reference_fix'], module, s['secret'], seed, int(b.get('fuzz_count', 16)), int(b.get('variants', 32)), int(b.get('po2', 18)), proof0=True, groth16=level_of(cfg) == 2,
                           mode=mode_of(b), fix=s['reference_fix'], rule=rule_of(b, module) if mode_of(b) == 'rule' else None)
    if journal(v, 'verdict') != 'PASS': fail('Proof 0 did not say PASS')
    if level_of(cfg) == 1:  # the arguments of open_with_outlayer need the journal from the receipt: find it now, not at publish
        try: journal_bytes(f'{w}/p0_succinct.bin', v)
        except RuntimeError as e: fail(f'Proof 0: {e}')
    json.dump({'times_s': t, 'at': now()}, open(f'{w}/proof0_times.json', 'w'))
    say(f'{now()} Proof 0 ready: VALID, PASS; prove {t["prove"]} s, succinct {t["succinct"]} s' + (f', Groth16 {t["groth16"]} s' if 'groth16' in t else '') + '. Next: publish')

def cmd_publish(a):
    cfg = load(a.config); b = cfg['bounty']; w = os.path.expanduser(cfg['prover']['workdir'])
    v = open(f'{w}/verify_p0.txt').read()
    module = os.path.join(ROOT, b['module']) if not os.path.isabs(b['module']) else b['module']
    if journal(v, 'original_hash') != sha_file(f'{module}/original.wasm'): fail('Proof 0 is not for this module')
    if journal(v, 'verdict') != 'PASS': fail('Proof 0 does not say PASS')
    if mode_of(b) == 'rule':
        # The corpus hash binds the public rule module and the public tests; recompute it here and refuse on a mismatch.
        if re.search(r'^image id: (\S+)', v, re.M).group(1) != CHECKERS['rule']: fail('Proof 0 was not made by the rule checker; set bounty.mode and make Proof 0 again')
        want = rule_corpus_hash(rule_of(b, module), f'{module}/public_tests.txt')
        if journal(v, 'corpus_hash') != want: fail(f'Proof 0\'s corpus hash is not the one of this rule module and these public tests ({want[:16]}...)')
    est, _ = proof_time(cfg['prover']['mode'], b['module'], cfg['prover'].get('workdir'), cfg['prover'].get('machine', 'this machine')); preview(cfg, est)
    why = window_rule(cfg, est)
    if why: fail(why)
    if not a.yes and input('\nType "publish" to create and open this bounty on testnet: ').strip() != 'publish': fail('not confirmed; nothing was sent')
    ref = sha_file(cfg['secrets']['reference_fix']) if os.path.exists(cfg['secrets']['reference_fix']) else journal(v, 'candidate_hash')
    create = {'original_hash': journal(v, 'original_hash'), 'corpus_hash': journal(v, 'corpus_hash'), 'image_id': re.search(r'^image id: (\S+)', v, re.M).group(1),
              'exploit_commitment': journal(v, 'exploit_commitment'), 'proof0_receipt_hash': sha_file(f'{w}/p0_succinct.bin'), 'max_commits': int(b['k']),
              'max_patch_bytes': int(b.get('max_patch_bytes', 1024)), 'reveal_gap_ns': str(int(b['reveal_gap_s']) * SEC), 'verdict_window_ns': str(int(b['verdict_window_h']) * 3600 * SEC),
              'attest_window_ns': str(3600 * SEC), 'expiry_ns': str(int(b['expiry_h']) * 3600 * SEC), 'attempt_fee': str(yocto(b['attempt_fee_near'])), 'fee_step': str(yocto(b['fee_step_near'])),
              'reference_fix_hash': ref, 'proof0_journal_hash': re.search(r'^journal sha256: (\S+)', v, re.M).group(1), 'reveal_window_ns': str(int(b['reveal_window_s']) * SEC),
              'fuzz_count': int(b.get('fuzz_count', 16)), 'variant_count': int(b.get('variants', 32)), 'level': level_of(cfg),
              'max_commits_per_account': int(b.get('max_commits_per_account', 0) or 0) or None}
    json.dump(create, open(f'{w}/create_call.json', 'w'))
    bid = str(view(cfg, 'get_next_bounty_id'))
    lv = level_of(cfg)
    # Build the opening call and check its money before create_bounty, so a failure here can never leave a created bounty
    # that cannot be opened, with its reward locked.
    try:
        if lv == 2: open_args = proof_args(w, 'p0', {'bounty_id': bid})
        elif lv == 1: open_args = outlayer_args(w, 'p0', {'bounty_id': bid})
    except (RuntimeError, OSError, KeyError, ValueError) as e: fail(f'the opening call could not be built, so nothing was sent: {e}')
    if lv == 1:
        min_dep = int(view(cfg, 'get_outlayer')['min_deposit']); dep = near_amount(min_dep).replace(' NEAR', '')
        have, need = balance(cfg, cfg['chain']['vendor_account']), yocto(b['reward_near']) + min_dep + yocto('0.05')
        if have is None or have < need: fail(f'the vendor account needs about {near_amount(need)} (the reward, OutLayer\'s deposit {dep} NEAR held while it works, and gas); it has {near_amount(have or 0)}; nothing was sent')
    tx1, ok1, why = send(cfg, cfg['chain']['vendor_account'], 'create_bounty', f'{w}/create_call.json', f'{b["reward_near"]} NEAR', log=f'{w}/run.log')
    say(f'create_bounty: {tx1} {"ok" if ok1 else "FAILED: " + why}')
    if not ok1: sys.exit(1)
    if lv == 2:
        tx2, ok2, why = send(cfg, cfg['chain']['vendor_account'], 'open_with_groth16', open_args, log=f'{w}/run.log')
        say(f'open_with_groth16: {tx2} {"ok" if ok2 else "FAILED: " + why}')
    elif lv == 1:
        tx2, ok2, why = send(cfg, cfg['chain']['vendor_account'], 'open_with_outlayer', open_args, f'{dep} NEAR', log=f'{w}/run.log')
        say(f'open_with_outlayer: {tx2} {"ok" if ok2 else "FAILED: " + why}; {dep} NEAR held while OutLayer works, then returned (less its fee)')
    else:
        tx2 = None
        say('Level 0: the bounty opens when two registered verifiers attest its Proof 0 (journal and receipt sha256 above, in create_call.json)')
    json.dump({'bounty_id': bid, 'create_tx': tx1, 'open_tx': tx2, 'at': now()}, open(f'{w}/published.json', 'w'))
    bb = view(cfg, 'get_bounty', {'bounty_id': bid})
    say(f'bounty {bid}: state {bb["state"]}, opened {bb["opened"]}, image id allowed {bb["image_id_allowed"]}. Add it to the watch config.')

# ---------------------------------------------------------------- watch and status
def watched(wcfg):
    for e in wcfg['bounties']:
        for bid in e['ids']: yield str(bid), e

def attempts(cfg, bid):
    b = view(cfg, 'get_bounty', {'bounty_id': bid})
    return b, [view(cfg, 'get_submission', {'bounty_id': bid, 'index': i}) for i in range(b['commits'])]

def state_load(wcfg):
    p = os.path.expanduser(wcfg['watch']['state']); return json.load(open(p)) if os.path.exists(p) else {}
def state_save(wcfg, st):
    p = os.path.expanduser(wcfg['watch']['state']); json.dump(st, open(p + '.tmp', 'w'), indent=1); os.replace(p + '.tmp', p)

def log_line(wcfg, msg):
    line = f'{now()} {msg}'; say(line); open(os.path.expanduser(wcfg['watch']['log']), 'a').write(line + '\n')

def prove_attempt(wcfg, bid, e, b, i, s, st):
    key = f'{bid}:{i}'; w = os.path.expanduser(f'{wcfg["watch"]["workdir"]}/b{bid}_a{i}'); os.makedirs(w, mode=0o700, exist_ok=True)
    level = int(b.get('level', 2))  # 2: Groth16 to the contract; 1: the succinct proof to OutLayer; 0: a posted verdict
    patch = f'{w}/patch.wasm'; open(patch, 'wb').write(base64.b64decode(s['patch']))
    sid = view(wcfg, 'get_submission_id', {'bounty_id': bid, 'index': i})
    module = os.path.join(ROOT, e['module']) if not os.path.isabs(e['module']) else e['module']
    if b['image_id'] in CHECKERS.values() and b['image_id'] != CHECKERS[mode_of(e)]:  # before any pod or proving
        raise RuntimeError(f'the bounty uses the {[m for m, x in CHECKERS.items() if x == b["image_id"]][0]} checker but its watch entry says mode {mode_of(e)}; fix the watch config')
    log_line(wcfg, f'bounty {bid} attempt {i}: proving (patch sha256 {sha_file(patch)[:16]}..., seed {s["seed"][:16]}..., deadline {datetime.fromtimestamp(int(s["deadline_ns"]) / 1e9, timezone.utc):%Y-%m-%d %H:%M} UTC)')
    prev = st.get(key, {})
    v = t = None
    ready = os.path.exists(f'{w}/u_args.json') if level == 2 else os.path.exists(f'{w}/u_succinct.bin')
    if prev.get('state') in ('proof ready', 'submit failed') and ready and os.path.exists(f'{w}/verify_u.txt'):
        # The proof exists: only the submit is tried again; no new pod and no new proving for this attempt.
        v, t = open(f'{w}/verify_u.txt').read(), prev.get('times_s', {})
        if not prev.get('hold_next'): log_line(wcfg, f'bounty {bid} attempt {i}: the proof is already made; submitting it again (try {prev.get("submit_failures", 0) + 1})')
    else:
        st[key] = {**{k: prev[k] for k in ('failures', 'gpu_wait') if k in prev}, 'state': 'proving', 'started': now()}; state_save(wcfg, st)
        if wcfg['prover']['mode'] == 'gpu':
            job = {'bounty_id': bid, 'index': i, 'name': e['name'], 'module': module, 'patch': patch, 'secret': os.path.expanduser(e['secret']),
                   'salt': os.path.expanduser(f'~/.kintsugi-salts/{e["name"]}.salt'), 'seed': s['seed'], 'sid': sid, 'fuzz': b['fuzz_count'],
                   'variants': b['variant_count'], 'image_id': b['image_id'], 'workdir': w}
            if mode_of(e) in ('output', 'rule'): job['reference_fix'] = os.path.expanduser(e['reference_fix'])
            if mode_of(e) == 'rule': job['rule'] = rule_of(e, module)
            last = None
            for n in (1, 2):
                try:
                    with ProverLock():
                        _, t = gpu.prove_on_gpu(wcfg, job, lambda m: log_line(wcfg, f'bounty {bid} attempt {i}: {m}'))
                        if level == 2: v, t['groth16'] = wrap(wcfg, w, 'u', mode_of(e))
                        else: v = verify_succinct(wcfg, w, 'u', mode_of(e))
                    break
                except gpu.NoGpuFree as ex:
                    if not gpu.settings(wcfg).get('cpu_fallback', True):
                        raise  # nothing to rent right now: the watch waits and tries again (failed_round)
                    log_line(wcfg, f'WARNING bounty {bid} attempt {i}: {ex}; proving on this machine (cpu) instead'); break
                except gpu.BudgetReached as ex:
                    if not gpu.settings(wcfg).get('cpu_fallback', True):
                        raise RuntimeError(f'{ex}; gpu.cpu_fallback is false: no CPU proving here') from None
                    log_line(wcfg, f'WARNING bounty {bid} attempt {i}: {ex}; proving on this machine (cpu) instead'); break
                except Exception as ex:  # noqa: BLE001
                    last = ex; log_line(wcfg, f'bounty {bid} attempt {i}: GPU try {n} of 2 failed ({ex})')
            if v is None and not gpu.settings(wcfg).get('cpu_fallback', True):
                raise RuntimeError(f'the GPU path gave no proof ({str(last)[:160]}); gpu.cpu_fallback is false, so nothing is proved on this machine')
            if v is None:
                log_line(wcfg, f'WARNING bounty {bid} attempt {i}: the GPU path did not give a proof; falling back to cpu on this machine (about 10 h here)')
        if v is None:
            v, t = prove_chain(wcfg, w, e['name'], patch, module, os.path.expanduser(e['secret']), s['seed'], b['fuzz_count'], b['variant_count'], int(e.get('po2', 18)), sid=sid, groth16=level == 2,
                               mode=mode_of(e), fix=os.path.expanduser(e['reference_fix']) if mode_of(e) in ('output', 'rule') else None,
                               rule=rule_of(e, module) if mode_of(e) == 'rule' else None)
    if journal(v, 'exploit_commitment') != b['exploit_commitment']: raise RuntimeError('the proof\'s secret commitment is not the bounty\'s (wrong secret or salt); not submitting')
    if journal(v, 'submission_id') != sid: raise RuntimeError('the proof is for another submission id; not submitting')
    verdict = journal(v, 'verdict')
    extra = f'; on {t["gpu"]}, pod {t["pod_seconds"]} s, ${t["cost_usd"]}' if t.get('gpu') else ''
    log_line(wcfg, f'bounty {bid} attempt {i}: proof ready, verdict {verdict}; prove {t.get("prove")} s, succinct {t.get("succinct")} s{f", Groth16 {t['groth16']} s" if t.get("groth16") else ""}{extra}')
    st[key] = {'state': 'proof ready', 'verdict': verdict, 'times_s': t, 'submit_failures': prev.get('submit_failures', 0)}; state_save(wcfg, st)
    hold = hold_pass(wcfg, st, bid, i, s) if verdict == 'PASS' else None
    if hold == 'hold':
        if not prev.get('hold_next'):
            log_line(wcfg, f'bounty {bid} attempt {i}: PASS held: another revealed attempt of this bounty is proved first, so every FAIL is submitted before a PASS closes the bounty')
        st[key]['hold_next'] = time.time() + int(wcfg['watch'].get('poll_s', 60)); state_save(wcfg, st)
        return
    if hold == 'margin':
        log_line(wcfg, f'bounty {bid} attempt {i}: PASS submitted now without waiting for the other attempts: less than {HOLD_PASS_MIN_LEFT_S // 3600} h of its verdict window are left, and a FAIL still being proved must never cost a correct fix its payout')
    fresh = view(wcfg, 'get_submission', {'bounty_id': bid, 'index': i})
    if fresh['outcome'] != 'Open': log_line(wcfg, f'bounty {bid} attempt {i}: already decided on chain ({fresh["outcome"]}); not submitting'); st[key] = {'state': 'decided elsewhere', 'outcome': fresh['outcome']}; return
    if level == 2:
        method = 'submit_groth16'
        tx, ok, why = send(wcfg, wcfg['chain']['submit_account'], method, proof_args(w, 'u', {'bounty_id': bid, 'index': i}), log=f'{w}/run.log')
    elif level == 1:
        method = 'check_with_outlayer'; dep = near_amount(view(wcfg, 'get_outlayer')['min_deposit']).replace(' NEAR', '')
        tx, ok, why = send(wcfg, wcfg['chain']['submit_account'], method, outlayer_args(w, 'u', {'bounty_id': bid, 'index': i}), f'{dep} NEAR', log=f'{w}/run.log')
    else:
        method = 'post_verdict'; rb = open(f'{w}/u_succinct.bin', 'rb').read(); p = f'{w}/u_post_call.json'
        json.dump({'bounty_id': bid, 'index': i, 'verdict': 'Pass' if verdict == 'PASS' else 'Fail', 'journal_hash': re.search(r'^journal sha256: (\S+)', v, re.M).group(1),
                   'receipt_hash': hashlib.sha256(rb).hexdigest()}, open(p, 'w'))
        tx, ok, why = send(wcfg, wcfg['chain'].get('vendor_account', wcfg['chain']['submit_account']), method, p, log=f'{w}/run.log')
        log_line(wcfg, f'bounty {bid} attempt {i}: Level 0: the verdict is posted; two registered verifiers must attest it before the attestation window closes')
    after = view(wcfg, 'get_submission', {'bounty_id': bid, 'index': i})
    log_line(wcfg, f'bounty {bid} attempt {i}: {method} {tx} {"ok" if ok else "FAILED: " + why}; outcome on chain {after["outcome"]}')
    st[key] = {'state': 'submitted' if ok else 'submit failed', 'tx': tx, 'verdict': verdict, 'outcome': after['outcome'], 'times_s': t, 'done': now(),
               'submit_failures': prev.get('submit_failures', 0) + (0 if ok else 1)}
    if not ok: return
    for f in ('u_succinct.bin',):
        if os.path.exists(f'{w}/{f}'): os.remove(f'{w}/{f}')

GPU_WAIT_FIRST_S, GPU_WAIT_NEXT_S, GPU_WAIT_MIN_LEFT_S = 300, 600, 7200  # 5 min, then every 10 min, while 2 h are left
HOLD_PASS_MIN_LEFT_S = 7200  # a held PASS is submitted anyway once less than 2 h of its own verdict window are left

def hold_pass(wcfg, st, bid, i, s, t=None):
    """FAIL proofs go first: a PASS pays and closes the bounty, and every attempt still open is then refunded unproved,
    so its FAIL could never be recorded. 'hold' this PASS while another revealed, open attempt of the same bounty has no
    proof yet; but 'margin' (submit it now) once less than 2 h of this PASS's own verdict window are left, so a FAIL
    still being proved never costs a correct fix its payout; None when nothing else waits."""
    t = time.time() if t is None else t
    try: _, subs = attempts(wcfg, bid)
    except Exception: return None  # noqa: BLE001 (cannot read: do not hold)
    waiting = False
    for j, o in enumerate(subs):
        if j == i or o['outcome'] != 'Open' or not o.get('revealed_at_ns'): continue
        rec = st.get(f'{bid}:{j}', {})
        if rec.get('state') not in ('proof ready', 'submitted', 'decided elsewhere', 'deadline passed', 'gave up'): waiting = True
    if not waiting: return None
    return 'margin' if int(s['deadline_ns']) / SEC - t < HOLD_PASS_MIN_LEFT_S else 'hold'

def utc_at(t): return f'{datetime.fromtimestamp(t, timezone.utc):%Y-%m-%d %H:%M} UTC'

def alert(wcfg, rec, msg):
    """A loud line in the watch log, kept in the state so `status` shows it: the watch never gives up silently."""
    rec.update(state='gave up', alert=f'{now()} {msg}'); log_line(wcfg, f'ALERT {msg}')

def failed_round(wcfg, st, bid, i, s, ex, t=None):
    """After a proving round that gave no proof. No GPU free: wait 5 minutes, then 10 between tries, as long as at least
    2 hours of the attempt's verdict window are left after the next try. Any other failure (a card the prover build does
    not run on, a bad proof): two rounds in all. Either way the end is a loud ALERT line, never a silent stop."""
    t = time.time() if t is None else t
    key = f'{bid}:{i}'; rec = st.get(key, {}); end = int(s['deadline_ns']) / SEC
    if isinstance(ex, gpu.NoGpuFree):
        n = rec.get('gpu_wait', {}).get('tries', 0) + 1
        nxt = t + (GPU_WAIT_FIRST_S if n == 1 else GPU_WAIT_NEXT_S)
        if end - nxt < GPU_WAIT_MIN_LEFT_S:
            alert(wcfg, rec, f'bounty {bid} attempt {i}: GAVE UP: no GPU was free in {n} tries, and a next try at {utc_at(nxt)} would leave less '
                             f'than 2 h of the verdict window (it ends {utc_at(end)}). Nothing more is proved here; the timeout rule decides this '
                             'attempt unless the vendor proves it another way.')
        else:
            rec.update(state='waiting for a GPU', gpu_wait={'tries': n, 'next_at': nxt, 'last': str(ex)[:200]})
            log_line(wcfg, f'bounty {bid} attempt {i}: WAITING for a GPU, try {n}, next try at {utc_at(nxt)}, verdict window ends {utc_at(end)}')
    else:
        rec.update(failures=rec.get('failures', 0) + 1, error=str(ex)[:300])
        if rec['failures'] >= 2:
            alert(wcfg, rec, f'bounty {bid} attempt {i}: STOPPED after 2 failed rounds ({str(ex)[:200]}). Nothing more is proved here; the timeout '
                             f'rule decides this attempt at {utc_at(end)} unless the vendor acts.')
        else:
            rec['state'] = 'failed'
            log_line(wcfg, f'bounty {bid} attempt {i}: FAILED ({ex}); try 1 of 2')
    st[key] = rec

def scan(wcfg, st):
    jobs = []
    for bid, e in watched(wcfg):
        try: b, subs = attempts(wcfg, bid)
        except Exception as ex: log_line(wcfg, f'bounty {bid}: could not read ({ex})'); continue  # noqa: BLE001
        if b['state'] != 'Open': continue
        for i, s in enumerate(subs):
            if s['outcome'] != 'Open' or not s.get('revealed_at_ns'): continue
            done = st.get(f'{bid}:{i}', {})
            if done.get('state') in ('submitted', 'decided elsewhere', 'deadline passed', 'gave up') or done.get('failures', 0) >= 2 or done.get('submit_failures', 0) >= 10: continue
            if done.get('gpu_wait', {}).get('next_at', 0) > time.time(): continue  # waiting for a GPU: not before its next try
            if done.get('hold_next', 0) > time.time(): continue  # a held PASS: looked at again after one poll
            ready = done.get('state') in ('proof ready', 'submit failed')
            jobs.append(((ready, ready and done.get('verdict') == 'PASS', int(s['revealed_at_ns'])), bid, e, b, i, s))
    # attempts with no proof yet first (oldest reveal first), then proofs ready to submit: every FAIL before any PASS
    return sorted(jobs, key=lambda j: j[0])

def cmd_watch(a):
    wcfg = load(a.config); st = state_load(wcfg)
    log_line(wcfg, f'watch started (mode {wcfg["prover"]["mode"]}, bounties {", ".join(b for b, _ in watched(wcfg))}, one job at a time)')
    if wcfg['prover']['mode'] == 'gpu':
        g = gpu.settings(wcfg)
        log_line(wcfg, f'GPU mode: rented GPU {", ".join(g["gpu_types"])} in {", ".join(g["data_centers"])}, cap {g["cap_minutes"]} min per pod, '
                       f'spend so far ${gpu.spend_total(g)} of a ${g["budget_usd"]} budget')
    while True:
        jobs = scan(wcfg, st)
        nowns = time.time() * SEC
        for _, bid, e, b, i, s in jobs:
            est = 60 * float(gpu.settings(wcfg)['cap_minutes']) + 900 if wcfg['prover']['mode'] == 'gpu' else proof_time('cpu', e['module'], None, wcfg['prover'].get('machine', 'this machine'))[0]
            left = (int(s['deadline_ns']) - nowns) / SEC
            if left <= 0: log_line(wcfg, f'bounty {bid} attempt {i}: its verdict deadline has passed; the timeout rule decides it'); st[f'{bid}:{i}'] = {'state': 'deadline passed'}; state_save(wcfg, st); continue
            if est and left < est * 1.2: log_line(wcfg, f'WINDOW AT RISK: bounty {bid} attempt {i} has {hm(left)} left; one proof here takes about {hm(est)}')
        jobs = [j for j in jobs if st.get(f'{j[1]}:{j[4]}', {}).get('state') != 'deadline passed']
        if jobs:
            _, bid, e, b, i, s = jobs[0]
            try: prove_attempt(wcfg, bid, e, b, i, s, st)
            except Exception as ex:  # noqa: BLE001
                failed_round(wcfg, st, bid, i, s, ex)
            state_save(wcfg, st)
            continue
        if a.once: log_line(wcfg, 'nothing to prove'); return
        time.sleep(int(wcfg['watch'].get('poll_s', 60)))

def cmd_status(a):
    wcfg = load(a.config); st = state_load(wcfg); nowns = time.time() * SEC
    for k, rec in st.items():
        if rec.get('alert'): say(f'ALERT {rec["alert"]}')
    for bid, e in watched(wcfg):
        try: b, subs = attempts(wcfg, bid)
        except Exception as ex: say(f'bounty {bid}: could not read ({ex})'); continue  # noqa: BLE001
        say(f'bounty {bid} ({e["name"]}): {b["state"]}, opened {b["opened"]}, {b["commits"]} of {b["max_commits"]} attempts, verdict window {span(int(b["verdict_window_ns"]) // SEC)}')
        for i, s in enumerate(subs):
            mine = st.get(f'{bid}:{i}', {})
            if s['outcome'] != 'Open': nxt = 'nothing: decided'
            elif not s.get('revealed_at_ns'): nxt = 'wait for the researcher to reveal'
            elif int(s['deadline_ns']) < nowns: nxt = 'deadline passed: anyone can claim the timeout'
            else: nxt = f'prove by {datetime.fromtimestamp(int(s["deadline_ns"]) / 1e9, timezone.utc):%Y-%m-%d %H:%M} UTC ({hm((int(s["deadline_ns"]) - nowns) / SEC)} left)' + (f'; watch: {mine.get("state")}' if mine else '')
            say(f'  attempt {i}: {s["outcome"]}{", revealed" if s.get("revealed_at_ns") else ""}; next: {nxt}' + (f'; tx {mine["tx"]}' if mine.get('tx') else ''))

def main():
    p = argparse.ArgumentParser(prog='skarbnik-vendor', description=__doc__.split('\n')[0])
    sub = p.add_subparsers(dest='cmd', required=True)
    i = sub.add_parser('init'); i.add_argument('--out', required=True); i.add_argument('--from', dest='from_'); i.add_argument('--yes', action='store_true', help='take the defaults or the --from values without asking')
    for name in ('check', 'prove0', 'publish', 'watch', 'status'):
        c = sub.add_parser(name); c.add_argument('--config', required=True)
        if name == 'publish': c.add_argument('--yes', action='store_true', help='skip the typed confirmation')
        if name == 'check':
            c.add_argument('--candidate', help='only run the native checker on this file and print its verdict (no chain, no proof)')
            c.add_argument('--seed', help='with --candidate: the fairness seed, 64 hex characters (default: random)')
            c.add_argument('--explain', action='store_true', help='with --candidate: also print the step that decided (for your eyes only)')
        if name == 'watch': c.add_argument('--once', action='store_true', help='prove what is waiting, then stop')
    a = p.parse_args()
    {'init': cmd_init, 'check': cmd_check, 'prove0': cmd_prove0, 'publish': cmd_publish, 'watch': cmd_watch, 'status': cmd_status}[a.cmd](a)

if __name__ == '__main__':
    main()
