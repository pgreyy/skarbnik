# The vendor tools container for the confidential proving spike: Python 3.12 (pinned by digest) with cryptography and
# dcap-qvl (pinned with hashes), to run vendor.py on the vendor machine. Not published; built locally on the VPS.
FROM python:3.12-slim-trixie@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159
COPY vendor-requirements.txt /opt/vendor-requirements.txt
RUN pip install --no-cache-dir --require-hashes -r /opt/vendor-requirements.txt
COPY vendor.py /opt/vendor.py
ENTRYPOINT ["python3", "-I", "/opt/vendor.py"]
